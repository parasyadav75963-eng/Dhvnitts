<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Top Header & Navigate Back Button -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <Button
            android:id="@+id/btn_nav_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Navigate Back"
            android:minHeight="48dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            style="?android:attr/borderlessButtonStyle" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Voice Library"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_centerInParent="true" />
    </RelativeLayout>

    <!-- यह वह लिस्ट (RecyclerView) है जिसमें सभी भाषाएं और आवाज़ें दिखेंगी -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view_voices"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</LinearLayout>
