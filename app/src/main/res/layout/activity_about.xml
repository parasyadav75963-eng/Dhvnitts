<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="About DhwaniTTS &amp; ITFB"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tv_about_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#E0E0E0"
            android:textSize="16sp"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="A Special Thanks To"
            android:textColor="#00E676"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tv_special_thanks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="• Developer: Paras Kumar Yadav\n• Content Creator: Shiv Gupta\n• Social Media Manager: Badal Baghela"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:lineSpacingExtra="6dp"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Connect With Our Community"
            android:textColor="#00E676"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btn_join_groups"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Join our groups"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btn_youtube"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="YouTube Channel"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btn_whatsapp_channel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="WhatsApp Channel"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btn_telegram_channel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Telegram Channel"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btn_facebook"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Facebook"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btn_instagram"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Instagram"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btn_x_twitter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="X (Twitter)"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btn_help_feedback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Help &amp; Feedback"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp" />

    </LinearLayout>
</ScrollView>
