<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Active Configuration Status"
            android:textColor="#00E676"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tv_active_config_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mode: Single | Primary: None | Sec: None | Num: None"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:background="#1A1A1A"
            android:padding="10dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Engine Mode (Single / Dual / Mix Auto-TTS)"
            android:textColor="#00E676"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinner_engine_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Primary Language"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <Spinner
            android:id="@+id/spinner_language"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginBottom="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Primary Voice"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <Spinner
            android:id="@+id/spinner_voice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tv_secondary_voice_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Secondary Voice (For English / Dual &amp; Mix Mode)"
            android:textColor="#00E676"
            android:textSize="15sp" />

        <Spinner
            android:id="@+id/spinner_secondary_voice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dedicated Voice for Numbers"
            android:textColor="#00E676"
            android:textSize="15sp" />

        <Spinner
            android:id="@+id/spinner_number_voice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tv_speech_rate_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Speech Rate: 50%"
            android:textColor="#FFFFFF" />

        <SeekBar
            android:id="@+id/seekbar_speech_rate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="50"
            android:layout_marginBottom="6dp" />

        <Switch
            android:id="@+id/switch_force_speech"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Force DhwaniTTS Speech Rate"
            android:textColor="#FFFFFF"
            android:minHeight="48dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tv_pitch_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pitch Rate: 50%"
            android:textColor="#FFFFFF" />

        <SeekBar
            android:id="@+id/seekbar_pitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="50"
            android:layout_marginBottom="6dp" />

        <Switch
            android:id="@+id/switch_force_pitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Force DhwaniTTS Pitch"
            android:textColor="#FFFFFF"
            android:minHeight="48dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Number Reading Mode"
            android:textColor="#FFFFFF" />

        <Spinner
            android:id="@+id/spinner_number_reading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Punctuation Reading Level"
            android:textColor="#FFFFFF" />

        <Spinner
            android:id="@+id/spinner_punctuation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btn_test"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Test Voice Preview"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btn_save_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save Settings"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btn_reset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Reset to Default" />

    </LinearLayout>
</ScrollView>
